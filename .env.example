# Config for docker-compose.yml (Docker reads a file literally named `.env` in this same
# folder automatically). Copy this to `.env` and adjust if you want; the defaults below are
# fine for local development. This is never real production data — production credentials
# will live only in the hosting provider's dashboard, never in a file at all.

POSTGRES_USER=gamerzone
POSTGRES_PASSWORD=devpassword_change_me
POSTGRES_DB=gamerzone
POSTGRES_PORT=5432
