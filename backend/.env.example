# Copy this file to `.env` and fill in real values. `.env` itself is gitignored —
# it never gets committed, because it will eventually hold real secrets.

APP_NAME=GamerZone API
APP_VERSION=0.1.0
DEBUG=true

# Must match the POSTGRES_USER/PASSWORD/DB/PORT in the root .env (docker-compose.yml).
# "localhost" here because the app runs directly on your machine and connects OUT to
# the Postgres container's exposed port. Once the backend itself is containerized
# (a later phase), this host changes to the docker-compose service name "db" instead.
DATABASE_URL=postgresql+asyncpg://gamerzone:devpassword_change_me@localhost:5432/gamerzone

# Signs and verifies JWTs. Anyone holding this value can forge a token for ANY user,
# so it must never be committed and must be different in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_your_own_do_not_use_this_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Holds the revoked-token blacklist. The trailing /0 selects Redis database 0.
# "localhost" for the same reason as DATABASE_URL: the app runs on your machine and
# connects out to the container's published port.
REDIS_URL=redis://localhost:6379/0

# Points at the local Mailpit container, which catches mail instead of delivering it.
# Read what "sent" at http://localhost:8025. Mailpit needs no credentials and no TLS.
#
# In production these become a real provider's host and credentials, with TLS on. Use
# port 2525 rather than 587: hosts routinely block outbound connections on the standard
# SMTP ports to prevent spam, which shows up as a connection timeout. See DEPLOYMENT.md.
# Only these values change; no application code does.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM=noreply@gamerzone.local
MAIL_FROM_NAME=GamerZone

EMAIL_VERIFICATION_EXPIRE_HOURS=24
# Where the link in the email points: a page on the frontend, which then calls the API
# with the token. Pointing it straight at the API would work but would leave the reader
# looking at raw JSON.
VERIFICATION_URL_BASE=http://localhost:3000/verify

# Deliberately far shorter than verification - a leaked reset link is an account
# takeover, so it should stop being useful quickly.
PASSWORD_RESET_EXPIRE_MINUTES=60
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password

# Origins the browser is allowed to call this API from - the frontend's address.
# Comma-separated, no trailing slash, and never "*": a wildcard cannot be combined
# with credentials, and would let any website call this API using a signed-in user's
# token. In production this becomes the deployed frontend domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
